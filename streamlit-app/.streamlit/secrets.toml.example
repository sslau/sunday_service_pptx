# Copy this file to `secrets.toml` (same folder) and fill in your values.

# Access password for the web app (login gate in app.py). Set the same value
# in Streamlit Cloud under Settings → Secrets. Leave out/empty = app stays open.
app_password = "change-me"

# Only needed for the Google Sheets backend; without it the app falls back to
# data/weeks.json (local only, wiped on Community Cloud restarts).

[store]
# The Google Sheets spreadsheet holding the data. Title, id, or full URL all
# work (a `weeks` tab is created automatically). Share the spreadsheet with the
# service-account email below, as Editor.
spreadsheet = "https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/edit"

# Google Cloud service account that gspread authenticates as. Create one at
# https://console.cloud.google.com/iam-admin/serviceaccounts, download its JSON
# key, and paste the fields here (private_key must use the TOML multiline form).
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

private_key = """-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBg...
...entire private key...
-----END PRIVATE KEY-----
"""

client_email = "svc-builder@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/svc-builder%40your-project-id.iam.gserviceaccount.com"